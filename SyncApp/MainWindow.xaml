<Window x:Class="SyncApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SyncApp"
        mc:Ignorable="d"
        Title="P2P File Sync"
        Height="620" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="#0F1923"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="BgBase"      Color="#0F1923"/>
        <SolidColorBrush x:Key="BgCard"      Color="#162030"/>
        <SolidColorBrush x:Key="BgInput"     Color="#1C2B3A"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#263547"/>
        <SolidColorBrush x:Key="BorderHover" Color="#2D78D6"/>
        <SolidColorBrush x:Key="Accent"      Color="#2D78D6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#3D8DE6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E2EAF4"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#6B8299"/>
        <SolidColorBrush x:Key="TextMono"    Color="#8FBCDC"/>
        <SolidColorBrush x:Key="StatusIdle"  Color="#6B8299"/>
        <SolidColorBrush x:Key="StatusGreen" Color="#3FB950"/>

        <!-- TextBox style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"   Value="#1C2B3A"/>
            <Setter Property="Foreground"   Value="#8FBCDC"/>
            <Setter Property="CaretBrush"   Value="#2D78D6"/>
            <Setter Property="BorderBrush"  Value="#263547"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="10,8"/>
            <Setter Property="FontFamily"   Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#2D78D6"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2D78D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"        Value="#2D78D6"/>
            <Setter Property="Foreground"        Value="#E2EAF4"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="18,9"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D8DE6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6BC4"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="50" CenterY="12"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2B3A"/>
                                <Setter Property="Foreground" Value="#3A5268"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="#8FBCDC"/>
            <Setter Property="BorderBrush"       Value="#263547"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="18,9"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"   Value="#1C2B3A"/>
                                <Setter TargetName="Bd" Property="BorderBrush"  Value="#2D78D6"/>
                                <Setter Property="Foreground" Value="#E2EAF4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#162030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#3A5268"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1C2B3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox item -->
        <Style x:Key="LogItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground"  Value="#8FBCDC"/>
            <Setter Property="FontFamily"  Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="8,3"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1C2B3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1C2B3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pulse animation for status dot -->
        <Storyboard x:Key="PulseAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="StatusDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3"
                             Duration="0:0:1"
                             AutoReverse="True"/>
        </Storyboard>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="⬡" FontSize="20" Foreground="#2D78D6"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="P2P File Sync" FontSize="18" FontWeight="SemiBold"
                       Foreground="#E2EAF4" VerticalAlignment="Center"/>
            <TextBlock Text="LAN · Serverless · Merkle-verified"
                       FontSize="12" Foreground="#3A5268"
                       VerticalAlignment="Center" Margin="14,2,0,0"/>
        </StackPanel>

        <!-- Folder + Status card -->
        <Border Grid.Row="2"
                Background="#162030"
                BorderBrush="#263547"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Folder row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="SYNC FOLDER"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#3A5268" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" x:Name="FolderPathTextBox"
                             IsReadOnly="True"
                             Style="{StaticResource InputStyle}"/>
                    <Button Grid.Column="2" Content="Browse"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Click="BrowseButton_OnClick"/>
                </Grid>

                <!-- Status row -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="#6B8299"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#3A5268" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Idle"
                                   Foreground="#6B8299" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Peer count badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PEERS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#3A5268" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Border Background="#1C2B3A" BorderBrush="#263547"
                                BorderThickness="1" CornerRadius="12"
                                Padding="10,3">
                            <TextBlock x:Name="PeerCountText" Text="0 found"
                                       FontSize="12" FontFamily="Cascadia Code, Consolas, Courier New"
                                       Foreground="#8FBCDC"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Activity Log card -->
        <Border Grid.Row="4"
                Background="#162030"
                BorderBrush="#263547"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log header -->
                <Border Grid.Row="0"
                        BorderBrush="#263547"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ACTIVITY LOG" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#3A5268"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Log entries -->
                <ListBox Grid.Row="1"
                         x:Name="ActivityLog"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource LogItemStyle}">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton"
                    Content="Refresh"
                    Style="{StaticResource GhostButton}"
                    IsEnabled="False"
                    Margin="0,0,10,0"
                    Click="RefreshButton_OnClick"/>
            <Button x:Name="StartButton"
                    Content="Start Watching"
                    Style="{StaticResource PrimaryButton}"
                    Click="StartButton_OnClick"/>
        </StackPanel>

    </Grid>
</Window>
